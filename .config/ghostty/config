command = $(which zsh) --login --interactive
shell-integration = zsh
maximize = true

# appearance
theme = Rose Pine
font-family = JetBrainsMonoNL Nerd Font Mono
font-size = 13
font-feature = -calt
font-feature = -liga
cursor-style = block
window-decoration = none
desktop-notifications = true

# keybindings
keybind = ctrl+q=close_surface
keybind = global:ctrl+slash=toggle_quick_terminal

# tmux window navigation (Ctrl+0-9)
keybind = ctrl+0=text:\x1b[27;5;48~
keybind = ctrl+1=text:\x1b[27;5;49~
keybind = ctrl+2=text:\x1b[27;5;50~
keybind = ctrl+3=text:\x1b[27;5;51~
keybind = ctrl+4=text:\x1b[27;5;52~
keybind = ctrl+5=text:\x1b[27;5;53~
keybind = ctrl+6=text:\x1b[27;5;54~
keybind = ctrl+7=text:\x1b[27;5;55~
keybind = ctrl+8=text:\x1b[27;5;56~
keybind = ctrl+9=text:\x1b[27;5;57~
