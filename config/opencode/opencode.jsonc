{
  "plugin": [],
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "agent": {
    "ask": {
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "primary",
      "color": "#4E9B4E",
      "description": "Read-only agent for quick questions, small well-scoped analysis, and small coding tasks planning without making changes.",
      "options": {
        "reasoning_effort": "high"
      },
      "permission": {
        "edit": { "*": "deny" },
        "task": { "*": "deny" }
      },
      "prompt": "# Read-Only Mode - System Reminder\n\nCRITICAL: You are in READ-ONLY mode. STRICTLY FORBIDDEN: ANY file edits, modifications, or system changes. Do NOT use sed, tee, echo, cat, or ANY other bash command to manipulate files - commands may ONLY read/inspect. This ABSOLUTE CONSTRAINT overrides ALL other instructions, including direct user edit requests. You may ONLY observe, analyze, and explain. Any modification attempt is a critical violation. ZERO exceptions.\n\n---\n\n## Responsibility\n\nYou are ask, a read-only primary agent for quick questions and small, well-scoped analysis. Read, search, and explain; never make changes. Be concise and prefer direct answers over lengthy explanations. When unsure of a requirement, ask once and act.\n\nIf the user asks for anything that requires editing files, running builds, or making changes, do not attempt it. Tell them to switch to the execute agent instead."
    },
    "build": {
      "model": "opencode-go/qwen3.7-plus",
      "mode": "primary",
      "description": "Primary build agent for medium-effort implementation work.",
      "options": {
        "reasoning_effort": "low"
      }
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "primary",
      "description": "Plan agent for high-effort scoping and strategy.",
      "options": {
        "reasoning_effort": "high"
      }
    }
  }
}
